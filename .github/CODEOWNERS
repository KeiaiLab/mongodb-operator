# 디렉토리/파일별 자동 리뷰어 매핑 (3-repo 통일)
# 형식: <pattern> <owner>
# 참고: https://docs.github.com/en/repositories/managing-your-repositories-settings-and-features/customizing-your-repository/about-code-owners

# 전체 기본 소유자
* @keiailab/maintainers

# 핵심 도메인 (mongodb-operator)
/api/                       @keiailab/maintainers
/cmd/                       @keiailab/maintainers
/internal/controller/       @keiailab/maintainers
/internal/mongodb/          @keiailab/maintainers
/internal/resources/        @keiailab/maintainers
/internal/assets/           @keiailab/maintainers

# 빌드/배포
/charts/                    @keiailab/maintainers
/deploy/                    @keiailab/maintainers
/config/                    @keiailab/maintainers
/.github/                   @keiailab/maintainers
