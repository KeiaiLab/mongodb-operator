{
  "annotations": {"list": [{"builtIn": 1, "datasource": {"type": "grafana", "uid": "-- Grafana --"}, "enable": true, "hide": true, "iconColor": "rgba(0, 211, 255, 1)", "name": "Annotations & Alerts", "type": "dashboard"}]},
  "description": "MongoDB Operator — Backup & PITR. MongoDBBackup CR phase + 백업 duration + oplog uploader queue (cycle 1+).",
  "editable": true,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1, "title": "Backup Phase Distribution (count by phase)", "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 4},
      "targets": [{"expr": "count by (phase) (mongodb_operator_backup_phase{cluster=~\"$cluster\"})", "legendFormat": "{{phase}}", "refId": "A"}]
    },
    {
      "id": 2, "title": "Backup Duration (last completion, seconds)", "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [{"expr": "mongodb_operator_backup_duration_seconds{cluster=~\"$cluster\"}", "legendFormat": "{{backup}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 3, "title": "PITR Oplog Uploader — Active (1 per applicable cluster)", "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [{"expr": "mongodb_operator_oplog_uploader_active{cluster=~\"$cluster\"}", "legendFormat": "{{cluster}}", "refId": "A"}]
    },
    {
      "id": 4, "title": "Failed Backups (rate, 5m)", "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"x": 0, "y": 12, "w": 24, "h": 6},
      "targets": [{"expr": "rate(mongodb_operator_backup_failures_total{cluster=~\"$cluster\"}[5m])", "legendFormat": "{{cluster}}", "refId": "A"}]
    }
  ],
  "schemaVersion": 39,
  "tags": ["mongodb-operator", "backup", "pitr"],
  "templating": {
    "list": [
      {"name": "DS_PROMETHEUS", "type": "datasource", "query": "prometheus"},
      {"name": "cluster", "type": "query", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "query": "label_values(mongodb_up, cluster)", "refresh": 1, "includeAll": true, "multi": true}
    ]
  },
  "time": {"from": "now-24h", "to": "now"},
  "title": "MongoDB Operator — Backup & PITR",
  "uid": "mongodb-operator-backup",
  "version": 1
