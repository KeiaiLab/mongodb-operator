{
  "annotations": {"list": [{"builtIn": 1, "datasource": {"type": "grafana", "uid": "-- Grafana --"}, "enable": true, "hide": true, "iconColor": "rgba(0, 211, 255, 1)", "name": "Annotations & Alerts", "type": "dashboard"}]},
  "description": "MongoDB Operator — ReplicaSet Health. 멤버 state, replication lag, oplog window. percona/mongodb_exporter:0.40 메트릭 기준.",
  "editable": true,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1, "title": "Member State (1=PRIMARY 2=SECONDARY 7=ARBITER 8=DOWN)", "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 8},
      "targets": [{"expr": "mongodb_mongod_replset_my_state{cluster=~\"$cluster\"}", "legendFormat": "{{instance}} state", "refId": "A"}]
    },
    {
      "id": 2, "title": "Replication Lag (seconds, secondary behind primary)", "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [{"expr": "mongodb_mongod_replset_member_replication_lag{cluster=~\"$cluster\"}", "legendFormat": "{{name}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 3, "title": "Oplog Window (hours of retention)", "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "targets": [{"expr": "(mongodb_mongod_replset_oplog_head_timestamp - mongodb_mongod_replset_oplog_tail_timestamp) / 3600", "legendFormat": "{{instance}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "h"}}
    },
    {
      "id": 4, "title": "Heartbeat Health (1=ok, 0=down)", "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"x": 0, "y": 16, "w": 24, "h": 6},
      "targets": [{"expr": "mongodb_mongod_replset_member_health{cluster=~\"$cluster\"}", "legendFormat": "{{name}}", "refId": "A"}]
    }
  ],
  "schemaVersion": 39,
  "tags": ["mongodb-operator", "replicaset"],
  "templating": {
    "list": [
      {"name": "DS_PROMETHEUS", "type": "datasource", "query": "prometheus"},
      {"name": "cluster", "type": "query", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "query": "label_values(mongodb_up, cluster)", "refresh": 1, "includeAll": true, "multi": true}
    ]
  },
  "time": {"from": "now-1h", "to": "now"},
  "title": "MongoDB Operator — ReplicaSet Health",
