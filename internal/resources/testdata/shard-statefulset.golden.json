{
  "metadata": {
    "name": "test-sharded-shard-0",
    "namespace": "default",
    "labels": {
      "app.kubernetes.io/component": "shard-0",
      "app.kubernetes.io/instance": "test-sharded",
      "app.kubernetes.io/managed-by": "mongodb-operator",
      "app.kubernetes.io/name": "mongodb"
    }
  },
  "spec": {
    "replicas": 3,
    "selector": {
      "matchLabels": {
        "app.kubernetes.io/component": "shard-0",
        "app.kubernetes.io/instance": "test-sharded",
        "app.kubernetes.io/managed-by": "mongodb-operator",
        "app.kubernetes.io/name": "mongodb"
      }
    },
    "template": {
      "metadata": {
        "labels": {
          "app.kubernetes.io/component": "shard-0",
          "app.kubernetes.io/instance": "test-sharded",
          "app.kubernetes.io/managed-by": "mongodb-operator",
          "app.kubernetes.io/name": "mongodb"
        }
      },
      "spec": {
        "volumes": [
          {
            "name": "keyfile-secret",
            "secret": {
              "secretName": "test-sharded-keyfile",
              "defaultMode": 256
            }
          },
          {
            "name": "keyfile",
            "emptyDir": {}
          },
          {
            "name": "scripts",
            "configMap": {
              "name": "test-sharded-shard-0-scripts",
              "defaultMode": 493
            }
          },
          {
            "name": "admin-credentials",
            "secret": {
              "secretName": "test-sharded-admin",
              "defaultMode": 256
            }
          },
          {
            "name": "tls-server",
            "secret": {
              "secretName": "test-sharded-tls",
              "defaultMode": 256
            }
          },
          {
            "name": "tls-server-pem",
            "emptyDir": {}
          }
        ],
        "initContainers": [
          {
            "name": "copy-keyfile",
            "image": "busybox:1.37",
            "command": [
              "sh",
              "-c",
              "cp /keyfile-secret/keyfile /keyfile/keyfile \u0026\u0026 chmod 400 /keyfile/keyfile"
            ],
            "resources": {},
            "volumeMounts": [
              {
                "name": "keyfile-secret",
                "readOnly": true,
                "mountPath": "/keyfile-secret"
              },
              {
                "name": "keyfile",
                "mountPath": "/keyfile"
              }
            ],
            "securityContext": {
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              },
              "runAsUser": 999,
              "runAsGroup": 999,
              "runAsNonRoot": true,
              "allowPrivilegeEscalation": false,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            }
          }
        ],
        "containers": [
          {
            "name": "mongodb",
            "image": "mongo:7.0",
            "args": [
              "--shardsvr",
              "--replSet",
              "test-sharded-shard-0",
              "--bind_ip_all",
              "--auth",
              "--keyFile",
              "/etc/mongodb-keyfile/keyfile",
              "--tlsMode",
              "requireTLS",
              "--tlsCertificateKeyFile",
              "/etc/ssl/mongo-pem/server.pem",
              "--tlsCAFile",
              "/etc/ssl/mongo/ca.crt",
              "--tlsAllowConnectionsWithoutCertificates",
              "--tlsAllowInvalidHostnames"
            ],
            "ports": [
              {
                "name": "mongodb",
                "containerPort": 27017
              }
            ],
            "env": [
              {
                "name": "MONGO_PORT",
                "value": "27018"
              },
              {
                "name": "MONGO_REPLSET",
                "value": "test-sharded-shard-0"
              },
              {
                "name": "MONGO_MEMBERS",
                "value": "test-sharded-shard-0-0.test-sharded-shard-0-headless.default.svc.cluster.local:27018,test-sharded-shard-0-1.test-sharded-shard-0-headless.default.svc.cluster.local:27018,test-sharded-shard-0-2.test-sharded-shard-0-headless.default.svc.cluster.local:27018"
              },
              {
                "name": "MONGO_CONFIGSVR"
              }
            ],
            "resources": {},
            "volumeMounts": [
              {
                "name": "data",
                "mountPath": "/data/db"
              },
              {
                "name": "keyfile",
                "readOnly": true,
                "mountPath": "/etc/mongodb-keyfile"
              },
              {
                "name": "scripts",
                "readOnly": true,
                "mountPath": "/scripts"
              },
              {
                "name": "admin-credentials",
                "readOnly": true,
                "mountPath": "/etc/mongodb-admin"
              },
              {
                "name": "tls-server",
                "readOnly": true,
                "mountPath": "/etc/ssl/mongo"
              },
              {
                "name": "tls-server-pem",
                "readOnly": true,
                "mountPath": "/etc/ssl/mongo-pem"
              }
            ],
            "livenessProbe": {
              "exec": {
                "command": [
                  "mongosh",
                  "--norc",
                  "--quiet",
                  "--port",
                  "27018",
                  "--eval",
                  "db.adminCommand('ping')"
                ]
              },
              "initialDelaySeconds": 30,
              "timeoutSeconds": 15,
              "periodSeconds": 30,
              "failureThreshold": 4
            },
            "readinessProbe": {
              "exec": {
                "command": [
                  "mongosh",
                  "--norc",
                  "--quiet",
                  "--port",
                  "27018",
                  "--eval",
                  "db.adminCommand('ping')"
                ]
              },
              "initialDelaySeconds": 10,
              "timeoutSeconds": 10,
              "periodSeconds": 15
            },
            "lifecycle": {
              "postStart": {
                "exec": {
                  "command": [
                    "/scripts/bootstrap-admin.sh"
                  ]
                }
              },
              "preStop": {
                "exec": {
                  "command": [
                    "/scripts/prestop-stepdown.sh"
                  ]
                }
              }
            },
            "securityContext": {
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              },
              "runAsUser": 999,
              "runAsNonRoot": true,
              "readOnlyRootFilesystem": false,
              "allowPrivilegeEscalation": false,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            }
          }
        ],
        "securityContext": {
          "runAsUser": 999,
          "runAsGroup": 999,
          "runAsNonRoot": true,
          "fsGroup": 999,
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "affinity": {
          "podAntiAffinity": {
            "preferredDuringSchedulingIgnoredDuringExecution": [
              {
                "weight": 100,
                "podAffinityTerm": {
                  "labelSelector": {
                    "matchLabels": {
                      "app.kubernetes.io/instance": "test-sharded"
                    }
                  },
                  "topologyKey": "kubernetes.io/hostname"
                }
              }
            ]
          }
        }
      }
    },
    "volumeClaimTemplates": [
      {
        "metadata": {
          "name": "data"
        },
        "spec": {
          "accessModes": [
            "ReadWriteOnce"
          ],
          "resources": {
            "requests": {
              "storage": "50Gi"
            }
          }
        },
        "status": {}
      }
    ],
    "serviceName": "test-sharded-shard-0-headless",
    "podManagementPolicy": "Parallel",
    "updateStrategy": {
      "type": "RollingUpdate"
    }
  },
  "status": {
    "replicas": 0,
    "availableReplicas": 0
  }
}
